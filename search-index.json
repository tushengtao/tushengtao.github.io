1,"t":{"1":{"position":[[2,2]]}}}],["历史",{"_index":0,"t":{"1":{"position":[[0,2]]}}}],["我们",{"_index":6,"t":{"4":{"position":[[1,2]]}}}],["时间",{"_index":10,"t":{"4":{"position":[[10,2]]}}}],["最新",{"_index":15,"t":{"35":{"position":[[7,2]]}}}],["来到",{"_index":3,"t":{"2":{"position":[[3,2]]}}}],["欢迎您",{"_index":2,"t":{"2":{"position":[[0,3]]}}}],["登录",{"_index":16,"t":{"35":{"position":[[9,2]]}}}],["页",{"_index":17,"t":{"35":{"position":[[11,1]]}}}]],"pipeline":["stemmer"]}},{"documents":[],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[],"invertedIndex":[],"pipeline":["stemmer"]}},{"documents":[{"i":3,"t":"欢迎您来到GoGoLLM的博客！","s":"欢迎您","u":"/blog/welcome","h":"","p":2},{"i":5,"t":"让我们在不到5分钟的时间内了解 GoGoLLM。","s":"简介","u":"/docs/intro","h":"","p":4},{"i":7,"t":"GoGoLLM是开发者优先的面向企业级LLM应用研发平台, 专注于提升企业级LLM应用的开发效率，以减少研发周期，快速重构产品， 让产品创新&提升体验不再遥远，产品智能化触手可及。","s":"GoGoLLM是什么","u":"/docs/intro","h":"#gogollm是什么","p":4},{"i":11,"t":"企业级垂直领域智能搜索是本开源项目的重心","s":"1. 智能语义化搜索","u":"/docs/intro","h":"#1-智能语义化搜索","p":4},{"i":13,"t":"此demo是智能租房搜索场景，支持智能搜索（包括数值如价格、面积）、多维度分析推荐房源。","s":"1.1 租房信息搜索","u":"/docs/intro","h":"#11-租房信息搜索","p":4},{"i":17,"t":"根据用户问题使用大模型进行问题分类，之后根据大模型分类结果动态路由到不同角色的大模型来回答问题。","s":"4. 问题分类-分支节点","u":"/docs/intro","h":"#4-问题分类-分支节点","p":4},{"i":19,"t":"基于代码调用实现百炼手机商品知识库检索，知识库检索功能基于阿里云百炼平台实现。","s":"5. 百炼公司智能客服","u":"/docs/intro","h":"#5-百炼公司智能客服","p":4},{"i":21,"t":"使用大模型将用户原问题进行重写。 原问题：我平时喜欢打游戏; 重写后的问题：请推荐一款适合打游戏的手机，注重性能、散热和屏幕刷新率。 重写后的问题能够提高检索召回率，使得检索结果更加符合用户意图。","s":"6. 百炼公司客服智能体-query重写编排","u":"/docs/intro","h":"#6-百炼公司客服智能体-query重写编排","p":4},{"i":25,"t":"实现了代码节点编码补全功能。 如有相关咨询可添加下方微信： tushengtao1014","s":"9. 代码节点-代码智能补全","u":"/docs/intro","h":"#9-代码节点-代码智能补全","p":4},{"i":28,"t":"docker docker-compose 配置好docker镜像加速，注意国内（China）可能无法直接从docker hub拉取，需要拉取如下镜像: pgvector/pgvector:pg16 redis:6.0 node:18.20.2 python:3.10-slim nginx:latest","s":"1.前置条件","u":"/docs/quick_deploy","h":"#1前置条件","p":26},{"i":30,"t":"git clone https://github.com/tushengtao/gogollm.git","s":"1.1 克隆代码","u":"/docs/quick_deploy","h":"#11-克隆代码","p":26},{"i":32,"t":"前端.env,前端目录是ui​ UMI_APP_BASE_URL是调用后端接口的地址，可以配置为部署服务器的有效ip或域名 UMI_APP_BASE_URL=http://{服务器有效ip}:9116 后端.env,后端目录是backend​ 必须配置,如下： # llm config OPENAI_API_BASE='https://xxx_host/v1' OPENAI_API_KEY='sk-xxx' 如果需要测试代码远程执行，需要配置： # 远程代码执行地址 # PBOX_EXECUTE_TYPE loacl or remote PBOX_EXECUTE_TYPE=remote PBOX_REMOTE_API_KEY=pb-xxx PBOX_REMOTE_URL=http://xxx:9501","s":"1.2 配置前端.env和后端.env","u":"/docs/quick_deploy","h":"#12-配置前端env和后端env","p":26},{"i":34,"t":"在quick_deploy目录下执行： docker-compose up -d 访问前端：http://ip:3000","s":"2.部署","u":"/docs/quick_deploy","h":"#2部署","p":26},{"i":36,"t":"我们在2025年对GoGoLLM进行了全面迭代优化，目前已在企业级大规模生产环境中运行（应用于多个垂直领域业务）。 具体迭代优化点如下：","s":"2025年GoGoLLM最新迭代","u":"/docs/update_2025","h":"","p":35},{"i":38,"t":"迭代优化大模型+ElasticSearch自然语言搜索解决方案，进一步抽象，适配大多数公司ElasticSearch搜索场景，可实现大模型AI搜索快速集成垂直领域搜索业务，以天为单位。","s":"1. 迭代优化自然语言搜索解决方案","u":"/docs/update_2025","h":"#1-迭代优化自然语言搜索解决方案","p":35},{"i":40,"t":"工作流可视化编排迭代升级，支持更友好、高效的拖拽式配置；输入和输出配置更灵活，支持并行、分支、human-in-loop、循环、批处理等;测试运行可视化展示，方便开发者快速调试；对于大模型-单智能体集成了企业级最佳实践，更可控的智能体编排：工具调用循环次数完全可控、支持主流的大模型厂商（阿里通义大模型、DeepSeek、火山引擎-豆包大模型、OpenAI等），并对阿里云系列等大模型做了结构化输出、深度思考的定制化集成。 最新工作流演示，以联网搜索智能体为例： 此工作流集成了文本内容安全审核，确保大模型回答的内容符合企业级安全规范。 大模型节点运行流程全透明，可视化点击查看输入和输出，以及工具调用迭代次数和调用结果。","s":"2. 迭代优化工作流可视化编排","u":"/docs/update_2025","h":"#2-迭代优化工作流可视化编排","p":35},{"i":42,"t":"集成自研的代码执行沙盒：gogollm-code-sandbox，支持单机大量并发执行。","s":"3. gogollm-code-sandbox","u":"/docs/update_2025","h":"#3-gogollm-code-sandbox","p":35},{"i":44,"t":"基于JinaAI Reader开源项目集成和优化实现gogollm-reader，可实现大模型对互联网网页详情内容读取，提升大模型回答内容的质量和数据丰富度。","s":"4. gogollm-reader","u":"/docs/update_2025","h":"#4-gogollm-reader","p":35},{"i":46,"t":"支持MCP集成。可集成市面上任何支持SSE协议的MCP 工具。极大方便大模型应用数据和工具集成。 目前GoGoLLM支持3类工具集成，分别是： 本地代码研发集成的工具 远程MCP工具 编排的工作流作为工具，基于此功能可方便实现类似的多智能体协作，实现复杂的业务编排场景（本质是分治思想）。 支持市场上所有SSE协议的MCP工具，如魔搭MCP市场：","s":"5. 支持MCP集成","u":"/docs/update_2025","h":"#5-支持mcp集成","p":35},{"i":48,"t":"后端架构重构，基于大模型应用最先进的LangGraph框架实现，基于大型开源项目有保障，可扩展、可维护。","s":"6. 后端架构重构","u":"/docs/update_2025","h":"#6-后端架构重构","p":35},{"i":50,"t":"实现可观测平台集成,可观测平台存储层基于大数据ClickHouse,可实现秒级内统计大量业务运行指标;基于可观测平台业非常方便实现 定性+定量的评估机制（具体实现可联系团队了解）;可实现提示词多版本管理；可视化追踪观察内部运行流程、每次运行成本等； 主页统计分析： 观察调用成本： 观察运行流程：","s":"7. 实现可观测平台集成","u":"/docs/update_2025","h":"#7-实现可观测平台集成","p":35},{"i":52,"t":"可无缝集成Higress AI网关，实现大模型应用的高可用、高并发。","s":"8. 可无缝集成Higress AI网关","u":"/docs/update_2025","h":"#8-可无缝集成higress-ai网关","p":35},{"i":54,"t":"权限管理完善，粒度更细，支持用户、角色、权限的管理。并实现操作审计功能，记录用户对平台的所有操作，方便后续的安全分析和审计。","s":"9. 权限管理完善","u":"/docs/update_2025","h":"#9-权限管理完善","p":35},{"i":57,"t":"......更多功能详情介绍以及企业级解决方案，可联系微信： tushengtao1014","s":"更多联系","u":"/docs/update_2025","h":"#更多联系","p":35}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/3",[0,4.367,1,4.367,2,1.674,3,4.367]],["t/5",[2,1.546,4,3.301,5,4.033,6,4.033,7,4.033,8,4.033,9,3.301,10,3.301]],["t/7",[2,1.074,11,2.292,12,2.801,13,2.801,14,2.076,15,3.156,16,2.076,17,3.156,18,1.707,19,2.801,20,3.156,21,2.801,22,2.801,23,2.801,24,2.801,25,1.957,26,2.292,27,4.411,28,2.801,29,2.801,30,2.801,31,2.801,32,2.801,33,2.801]],["t/11",[14,2.13,34,2.765,35,2.765,36,2.412,37,2.412,38,3.957,39,2.765,40,2.765,41,3.957]],["t/13",[36,2.724,37,2.724,42,3.498,43,3.498,44,2.444,45,1.882,46,3.498,47,3.498,48,3.498,49,3.498,50,3.498,51,2.863,52,2.863,53,3.498]],["t/17",[54,4.161,55,2.19,56,3.823,57,2.565,58,1.607,59,1.791,60,2.19,61,4.161,62,3.134,63,2.19,64,3.134,65,3.134,66,3.134,67,2.565,68,2.19]],["t/19",[18,1.999,69,2.308,70,2.292,71,1.999,72,1.475,73,4.288,74,4.288,75,2.685,76,3.28,77,4.288,78,3.509,79,1.999,80,2.685,81,2.685]],["t/21",[52,2.024,55,2.469,56,3.682,57,2.024,58,0.85,59,0.948,60,1.728,63,1.728,75,2.024,78,2.892,82,2.473,83,3.534,84,4.123,85,2.473,86,2.473,87,3.534,88,2.473,89,2.473,90,2.473,91,2.473,92,2.473,93,2.473,94,2.473,95,2.473,96,2.473,97,2.473,98,2.473,99,2.473,100,2.473,101,2.473,102,2.024,103,2.473]],["t/25",[70,2.572,72,1.266,79,2.244,104,3.013,105,3.681,106,3.681,107,3.681,108,3